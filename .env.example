# Database (Supabase PostgreSQL)
# Prefer Session pooler for IPv4 networks (Connect → Session pooler in dashboard)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Assistant (server-side only — never expose to the browser)
# OpenAI-compatible APIs (OpenAI, xAI Grok, etc.)
AI_API_KEY=
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# For xAI Grok:
# AI_BASE_URL="https://api.x.ai/v1"
# AI_MODEL="grok-2-latest"
